{
  "info": {
    "name": "EduAI Proctoring API",
    "description": "Postman collection for all EduAI proctoring endpoints.\n\nSetup:\n1. Set the `base_url` variable to your server (default: http://localhost:8000).\n2. For image/video endpoints, select real files in the Body tab.\n3. For the base64 endpoint, paste actual base64 strings into the JSON body.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Simple liveness probe. Returns { \"status\": \"ok\" }."
          }
        }
      ]
    },
    {
      "name": "Object Detection",
      "item": [
        {
          "name": "Object Detection — Single Frame",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": "",
                  "description": "Select an image file (jpg/png)"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/analysis/object-frame",
              "host": ["{{base_url}}"],
              "path": ["analysis", "object-frame"]
            },
            "description": "Run YOLO object detection on a single image frame.\n\nBody: form-data with `image` (File)."
          }
        },
        {
          "name": "Object Detection — Video",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "video",
                  "type": "file",
                  "src": "",
                  "description": "Select a video file (mp4)"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/analysis/object-video",
              "host": ["{{base_url}}"],
              "path": ["analysis", "object-video"]
            },
            "description": "Run YOLO object detection on a 7-second video.\nProcesses every 5th frame with early stopping.\n\nBody: form-data with `video` (File)."
          }
        }
      ]
    },
    {
      "name": "Gaze Detection",
      "item": [
        {
          "name": "Gaze Detection — Video",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "video",
                  "type": "file",
                  "src": "",
                  "description": "Select a video file (mp4)"
                },
                {
                  "key": "calibrating",
                  "value": "false",
                  "type": "text",
                  "description": "Set to 'true' during calibration phase"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/analysis/gaze-video",
              "host": ["{{base_url}}"],
              "path": ["analysis", "gaze-video"]
            },
            "description": "Run eye-gaze detection on a 7-second video.\n\nBody: form-data with `video` (File) and optional `calibrating` (text, default false)."
          }
        }
      ]
    },
    {
      "name": "Face Recognition",
      "item": [
        {
          "name": "Face Recognition — Frame (image files)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "frame",
                  "type": "file",
                  "src": "",
                  "description": "Current exam webcam frame (jpg/png)"
                },
                {
                  "key": "reference",
                  "type": "file",
                  "src": "",
                  "description": "Authorised student ID photo (jpg/png)"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/analysis/face-frame",
              "host": ["{{base_url}}"],
              "path": ["analysis", "face-frame"]
            },
            "description": "Compare a webcam frame against a reference ID photo.\n\nBody: form-data with `frame` (File) and `reference` (File).\n\nReturns: { face_recognition: { id, timestamp, flag, probability, evidence } }"
          }
        },
        {
          "name": "Face Recognition — Base64 (JSON)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"frame\": \"<paste_base64_encoded_frame_here>\",\n  \"reference\": \"<paste_base64_encoded_reference_here>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/analysis/face-base64",
              "host": ["{{base_url}}"],
              "path": ["analysis", "face-base64"]
            },
            "description": "Compare two base64-encoded images (for .NET backend calls).\n\nBody: raw JSON with `frame` (string) and `reference` (string).\nSupports data-URI prefix (e.g. data:image/jpeg;base64,...).\n\nReturns: { face_recognition: { id, timestamp, flag, probability, evidence } }"
          }
        }
      ]
    }
  ]
}
